{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>UbiqueInnovation/renovate-config-backend:base.json5",
        "schedule:earlyMondays"
    ],
    "reviewersFromCodeOwners": true,
    "automerge": false,
    "packageRules": [
        {
            "matchPackageNames": [
                "*"
            ],
            "automerge": false
        }
    ]
}
