{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":pinAllExceptPeerDependencies",
        "schedule:earlyMondays",
        "abandonments:recommended",
        "docker:enableMajor",
        "helpers:pinGitHubActionDigests"
    ],
    "configMigration": true,
    "minimumReleaseAge": "7 days",
    "enabledManagers": [
        "maven",
        "github-actions",
        "docker-compose",
        "dockerfile",
        "custom.regex",
        "pip_requirements"
    ],
    "ignorePaths": [
        "**/node_modules/**",
        "**/bower_components/**",
        "**/vendor/**",
        "**/examples/**",
        "**/__tests__/**",
        "**/tests/**",
        "**/__fixtures__/**"
    ],
    "reviewersFromCodeOwners": true,
    "automerge": false,
    "separateMajorMinor": true,
    "separateMinorPatch": true,
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)src/(main|test)/java/.*\\.java$/"
            ],
            "matchStrings": [
                "DockerImageName\\.parse\\(\\s*\"(?<depName>[^\"\\s]+?)(?::(?<currentValue>[A-Za-z0-9_][A-Za-z0-9_.-]*))?(?:@(?<currentDigest>sha256:[a-f0-9]+))?\"\\s*\\)",
                "new\\s+[A-Za-z0-9_$.]+Container(?:\\s*<[^>]*>)?\\s*\\(\\s*\"(?<depName>[^\"\\s]+?)(?::(?<currentValue>[A-Za-z0-9_][A-Za-z0-9_.-]*))?(?:@(?<currentDigest>sha256:[a-f0-9]+))?\"\\s*\\)"
            ],
            "datasourceTemplate": "docker",
            "currentValueTemplate": "{{#if currentValue}}{{{currentValue}}}{{else}}latest{{/if}}",
            "depTypeTemplate": "testcontainers"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/workflows/.*\\.ya?ml$/"
            ],
            "matchStrings": [
                "maven-version:\\s*[\"']?(?<currentValue>[\\d.]+)[\"']?",
                "default:\\s*[\"']?(?<currentValue>[\\d.]+)[\"']?\\s*# renovate: maven-version"
            ],
            "datasourceTemplate": "maven",
            "depNameTemplate": "maven",
            "packageNameTemplate": "org.apache.maven:apache-maven",
            "versioningTemplate": "maven"
        }
    ],
    "packageRules": [
        {
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch"
            ],
            "groupName": "Dependencies"
        },
        {
            "matchManagers": [
                "docker-compose"
            ],
            "groupName": "Docker Compose Updates"
        },
        {
            "matchManagers": [
                "dockerfile"
            ],
            "groupName": "Dockerfile Updates"
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "GitHub Actions Updates",
            "minimumReleaseAge": "1 day"
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "matchPackageNames": [
                "/^UbiqueInnovation/action-systems-.+$/",
                "m-s-abeer/update-gha-summary-with-workflow-inputs",
                "s4u/maven-settings-action"
            ],
            "abandonmentThreshold": "3 years"
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "matchPackageNames": [
                "UbiqueInnovation/**"
            ],
            "minimumReleaseAge": "4 hours"
        },
        {
            "matchDatasources": [
                "maven"
            ],
            "groupName": "Spring Boot/Cloud dependencies",
            "matchPackageNames": [
                "org.springframework.boot:spring-boot{/,}**",
                "org.springframework.cloud:spring-cloud{/,}**",
                "com.azure.spring:spring-cloud-azure{/,}**"
            ]
        },
        {
            "matchPackageNames": [
                "edu.ucar:grib"
            ],
            "allowedVersions": "!/^8\\..*$/"
        },
        {
            "matchPackageNames": [
                "io.kubernetes:client-java"
            ],
            "allowedVersions": "!/^\\d+\\.\\d+\\.\\d+-legacy$/"
        },
        {
            "matchPackageNames": [
                "commons-cli:commons-cli"
            ],
            "allowedVersions": "!/-.+$/"
        },
        {
            "matchDatasources": [
                "maven"
            ],
            "groupName": "uetlib",
            "minimumReleaseAge": "4 hours",
            "matchPackageNames": [
                "/^ch\\.ubique\\.uetlib:uetlib.*$/"
            ],
            "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/"
        },
        {
            "description": "Migrate uetlib Maven coordinates to the public groupId",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "/^ch\\.ubique:uetlib.*$/"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.ubique.uetlib:' packageName}}}",
            "automerge": false,
            "prBodyNotes": [
                "This migration changes the Maven groupId. Verify that the target uetlib release is available under ch.ubique.uetlib before merging."
            ]
        },
        {
            "description": "Target the first public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-errorprone",
                "ch.ubique:uetlib-webp"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.ubique.uetlib:' packageName}}}",
            "replacementVersion": "1.0.0",
            "automerge": false
        },
        {
            "description": "Target the first public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-testapp"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.ubique.uetlib:' packageName}}}",
            "replacementVersion": "2.0.0",
            "automerge": false
        },
        {
            "description": "Target the first public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-bom",
                "ch.ubique:uetlib-parent"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.ubique.uetlib:' packageName}}}",
            "replacementVersion": "2026.11.0",
            "automerge": false
        },
        {
            "description": "Target the first public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-core",
                "ch.ubique:uetlib-db",
                "ch.ubique:uetlib-monitoring",
                "ch.ubique:uetlib-payment",
                "ch.ubique:uetlib-payment-coverage",
                "ch.ubique:uetlib-payment-datatrans",
                "ch.ubique:uetlib-payment-parent",
                "ch.ubique:uetlib-payment-postfinance",
                "ch.ubique:uetlib-spring-boot-test",
                "ch.ubique:uetlib-spring-cloud",
                "ch.ubique:uetlib-spring-cloud-coverage",
                "ch.ubique:uetlib-spring-cloud-parent",
                "ch.ubique:uetlib-spring-cloud-security",
                "ch.ubique:uetlib-storage",
                "ch.ubique:uetlib-storage-spring-boot",
                "ch.ubique:uetlib-test",
                "ch.ubique:uetlib-testcontainers",
                "ch.ubique:uetlib-testcontainers-coverage",
                "ch.ubique:uetlib-testcontainers-influxdb",
                "ch.ubique:uetlib-testcontainers-kafka",
                "ch.ubique:uetlib-testcontainers-mariadb",
                "ch.ubique:uetlib-testcontainers-mongodb",
                "ch.ubique:uetlib-testcontainers-mysql",
                "ch.ubique:uetlib-testcontainers-parent",
                "ch.ubique:uetlib-testcontainers-postgresql",
                "ch.ubique:uetlib-testcontainers-redis"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.ubique.uetlib:' packageName}}}",
            "replacementVersion": "3.0.0",
            "automerge": false
        },
        {
            "description": "Target the first public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-geo",
                "ch.ubique:uetlib-geo-coverage",
                "ch.ubique:uetlib-geo-db",
                "ch.ubique:uetlib-geo-job",
                "ch.ubique:uetlib-geo-parent",
                "ch.ubique:uetlib-spring-boot",
                "ch.ubique:uetlib-spring-boot-coverage",
                "ch.ubique:uetlib-spring-boot-geo",
                "ch.ubique:uetlib-spring-boot-parent",
                "ch.ubique:uetlib-spring-boot-security"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.ubique.uetlib:' packageName}}}",
            "replacementVersion": "4.0.0",
            "automerge": false
        },
        {
            "description": "Target the first public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-spring-boot-starter-parent"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.ubique.uetlib:' packageName}}}",
            "replacementVersion": "4.1.1-2026.11.0",
            "automerge": false
        },
        {
            "description": "Target the first public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-job",
                "ch.ubique:uetlib-self-bom"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.ubique.uetlib:' packageName}}}",
            "replacementVersion": "6.0.0",
            "automerge": false
        },
        {
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "joda-time:joda-time"
            ],
            "abandonmentThreshold": "1 day"
        },
        {
            "matchPackageNames": [
                "*"
            ],
            "automerge": false
        }
    ]
}
