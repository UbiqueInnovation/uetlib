{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Replace legacy ch.ubique:uetlib-* Maven coordinates with the public ch.uetlib migration releases.",
    "packageRules": [
        {
            "description": "Migrate uetlib Maven coordinates to the public groupId",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "/^ch\\.ubique:uetlib.*$/"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.uetlib:' packageName}}}",
            "automerge": false,
            "prBodyNotes": [
                "This migration changes the Maven groupId. Verify that the target uetlib release is available under ch.uetlib before merging."
            ]
        },
        {
            "description": "Target the current public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-errorprone"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.uetlib:' packageName}}}",
            "replacementVersion": "0.1.1",
            "automerge": false
        },
        {
            "description": "Target the current public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-webp"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.uetlib:' packageName}}}",
            "replacementVersion": "1.0.3",
            "automerge": false
        },
        {
            "description": "Target the current public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-testapp"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.uetlib:' packageName}}}",
            "replacementVersion": "2.0.1",
            "automerge": false
        },
        {
            "description": "Target the current public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-bom"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.uetlib:' packageName}}}",
            "replacementVersion": "2026.11.4",
            "automerge": false
        },
        {
            "description": "Target the current public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-parent"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.uetlib:' packageName}}}",
            "replacementVersion": "2026.11.2",
            "automerge": false
        },
        {
            "description": "Target the current public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-core",
                "ch.ubique:uetlib-db",
                "ch.ubique:uetlib-spring-boot-test",
                "ch.ubique:uetlib-spring-cloud",
                "ch.ubique:uetlib-spring-cloud-coverage",
                "ch.ubique:uetlib-spring-cloud-parent",
                "ch.ubique:uetlib-spring-cloud-security",
                "ch.ubique:uetlib-test",
                "ch.ubique:uetlib-testcontainers",
                "ch.ubique:uetlib-testcontainers-coverage",
                "ch.ubique:uetlib-testcontainers-influxdb",
                "ch.ubique:uetlib-testcontainers-kafka",
                "ch.ubique:uetlib-testcontainers-mariadb",
                "ch.ubique:uetlib-testcontainers-mongodb",
                "ch.ubique:uetlib-testcontainers-mysql",
                "ch.ubique:uetlib-testcontainers-parent",
                "ch.ubique:uetlib-testcontainers-postgresql",
                "ch.ubique:uetlib-testcontainers-redis"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.uetlib:' packageName}}}",
            "replacementVersion": "3.0.1",
            "automerge": false
        },
        {
            "description": "Target the current public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-payment",
                "ch.ubique:uetlib-payment-coverage",
                "ch.ubique:uetlib-payment-datatrans",
                "ch.ubique:uetlib-payment-parent",
                "ch.ubique:uetlib-payment-postfinance",
                "ch.ubique:uetlib-storage"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.uetlib:' packageName}}}",
            "replacementVersion": "3.0.2",
            "automerge": false
        },
        {
            "description": "Target the current public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-monitoring",
                "ch.ubique:uetlib-storage-spring-boot"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.uetlib:' packageName}}}",
            "replacementVersion": "3.0.2",
            "automerge": false
        },
        {
            "description": "Target the current public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-geo",
                "ch.ubique:uetlib-geo-coverage",
                "ch.ubique:uetlib-geo-db",
                "ch.ubique:uetlib-geo-job",
                "ch.ubique:uetlib-geo-parent",
                "ch.ubique:uetlib-geo-spring-boot"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.uetlib:' packageName}}}",
            "replacementVersion": "4.0.3",
            "automerge": false
        },
        {
            "description": "Target the current public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-spring-boot",
                "ch.ubique:uetlib-spring-boot-coverage",
                "ch.ubique:uetlib-spring-boot-parent",
                "ch.ubique:uetlib-spring-boot-security"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.uetlib:' packageName}}}",
            "replacementVersion": "4.0.2",
            "automerge": false
        },
        {
            "description": "Target the current public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-spring-boot-starter-parent"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.uetlib:' packageName}}}",
            "replacementVersion": "4.1.2-2026.11.6",
            "automerge": false
        },
        {
            "description": "Target the current public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-self-bom"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.uetlib:' packageName}}}",
            "replacementVersion": "6.0.6",
            "automerge": false
        },
        {
            "description": "Target the current public migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-job"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique:' 'ch.uetlib:' packageName}}}",
            "replacementVersion": "6.0.5",
            "automerge": false
        },
        {
            "description": "Move intermediate public coordinates to ch.uetlib, preserving versions",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "/^ch\\.ubique\\.uetlib:uetlib.*$/"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique[.]uetlib:' 'ch.uetlib:' packageName}}}",
            "automerge": false
        },
        {
            "description": "Migrate the recovered inotify library to its public coordinates",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:inotify"
            ],
            "replacementName": "ch.uetlib:uetlib-inotify-java",
            "replacementVersion": "3.0.3",
            "automerge": false
        },
        {
            "description": "Move Spring Boot geo integration into the geo repository",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique:uetlib-spring-boot-geo"
            ],
            "replacementName": "ch.uetlib:uetlib-geo-spring-boot",
            "replacementVersion": "4.0.3",
            "automerge": false
        },
        {
            "description": "Rename intermediate Spring Boot geo coordinates while preserving their version",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique.uetlib:uetlib-spring-boot-geo",
                "ch.uetlib:uetlib-spring-boot-geo"
            ],
            "replacementName": "ch.uetlib:uetlib-geo-spring-boot",
            "automerge": false
        },
        {
            "description": "Use the Spring Boot configuration-prefix migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique.uetlib:uetlib-spring-boot-parent",
                "ch.ubique.uetlib:uetlib-spring-boot",
                "ch.ubique.uetlib:uetlib-spring-boot-security",
                "ch.ubique.uetlib:uetlib-spring-boot-coverage"
            ],
            "replacementNameTemplate": "{{{replace '^ch[.]ubique[.]uetlib:' 'ch.uetlib:' packageName}}}",
            "replacementVersion": "4.0.2",
            "automerge": false
        },
        {
            "description": "Use the storage Spring Boot configuration-prefix migration release",
            "matchManagers": [
                "maven"
            ],
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique.uetlib:uetlib-storage-spring-boot"
            ],
            "replacementName": "ch.uetlib:uetlib-storage-spring-boot",
            "replacementVersion": "3.0.2",
            "automerge": false
        }
    ]
}
